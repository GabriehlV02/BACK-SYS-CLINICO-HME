AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# IntegraciÃ³n del servidor DICOM Orthanc
ORTHANC_URL=http://192.168.2.58:8042
ORTHANC_USERNAME=
ORTHANC_PASSWORD=
